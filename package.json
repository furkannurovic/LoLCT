{
  "name": "lol-champ-tracker",
  "version": "1.2.0",
  "description": "League of Legends match tracker — match history with per-game performance marks, duo detection and per-champion stats from the official Riot API, stored in a local JSON database.",
  "author": "furkan",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icons": "node make-icon.js",
    "dist": "electron-builder --win portable",
    "dist:win": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.furkan.lolchamptracker",
    "productName": "LoL Champ Tracker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "riot.js",
      "db.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "champions.json",
      "champions-data.js",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "LoL-Champ-Tracker.exe"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "darkModeSupport": true,
      "identity": null,
      "artifactName": "LoL-Champ-Tracker-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "LoL Champ Tracker ${version}"
    }
  }
}
